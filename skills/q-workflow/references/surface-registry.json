  ],
  "ignore": {
    "directories": [".git", "__pycache__", "node_modules", ".venv", "venv", ".tmp"],
    "suffixes": [".pyc", ".pyo"]
  },
  "policy": {
    "runtime_read_only": true,
    "bootstrap_is_merge_source": false,
    "unregistered_runtime_is_error": true,
    "hash_algorithm": "sha256",
    "remote_freshness": "unproven-until-fetch-receipt"
  }
